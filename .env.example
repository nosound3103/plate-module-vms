# Required: MQTT over WebSocket TLS. Use a hostname without wss:// or /mqtt.
MQTT_HOST=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PORT=443
MQTT_WS_PATH=/mqtt
# Required: tts_<name>_01. Choose a unique name for each running instance.
# The bbox connection uses tts_<name>_bbox_01; reserve both IDs for this instance.
MQTT_CLIENT_ID=tts_plate_01

# Required: sync only this organization and these zones (comma-separated IDs).
VMS_ORGANIZATION_ID=
VMS_ZONE_IDS=
# Optional: limit discovery to one camera code; empty means all PLATE cameras.
VMS_CAMERA_CODE=
VMS_CAMERA_SYNC_SECONDS=30

# Connection and bounded configuration queue.
MQTT_KEEPALIVE_SECONDS=30
MQTT_RECONNECT_MAX_SECONDS=30
VMS_CONFIG_QUEUE_SIZE=256
VMS_CONFIG_MAX_BYTES=1048576
VMS_SHUTDOWN_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# Docker injects .env. Python reads process environment only.

# Compose: choose exactly one profile: gpu, cpu or sync.
# Optional GPU base image override at build time.
# CUDA_BASE_IMAGE=multi-camera-ai:cu128

# Vehicle detection (gpu/cpu profiles).
# Image defaults: CPU image -> cpu; GPU image -> cuda:0.
# Uncomment to override the image default.
# PLATE_DEVICE=cpu
# Container mount path. Native Python defaults to models/weights in the project.
PLATE_WEIGHTS_DIR=/models
PLATE_VEHICLE_WEIGHT=last_vehicle_s_07042023_640_hp.pt
# Optional verified TensorRT engine (CUDA only); checkpoint still supplies class metadata.
PLATE_VEHICLE_ENGINE=
PLATE_VEHICLE_ENGINE_SHA256=
PLATE_VEHICLE_SHA256=1dd3770b89f3517c81e1d1101dd7815b0c0fc4b16741b1769a655168c95673c7
PLATE_IMAGE_SIZE=640
PLATE_VEHICLE_CONFIDENCE=0.4
PLATE_VEHICLE_IOU=0.45
PLATE_MAX_DETECTIONS=256
PLATE_MAX_FPS=5
PLATE_MAX_FRAME_AGE_SECONDS=1
PLATE_RTSP_OPEN_TIMEOUT_MS=5000
PLATE_RTSP_READ_TIMEOUT_MS=2000
PLATE_RTSP_TRANSPORT=tcp
PLATE_TORCH_THREADS=1
PLATE_SHUTDOWN_TIMEOUT_SECONDS=12

# Recognition worker. Events require OCR; vehicle bbox works independently.
PLATE_OCR_ENABLED=true
PLATE_PLATE_CONFIDENCE=0.55
PLATE_CHARACTER_CONFIDENCE=0.35
PLATE_ATTRIBUTE_CONFIDENCE=0.5
PLATE_OCR_INTERVAL_SECONDS=0.5
PLATE_OCR_MAX_RESULT_AGE_SECONDS=2
PLATE_OCR_MAX_VEHICLES=16
PLATE_OCR_MAX_PLATES_PER_VEHICLE=3
PLATE_OCR_MAX_PENDING_RESULTS=128
# Model filenames and SHA-256 default to models/manifest.json identities.
# Overrides require both PLATE_<ROLE>_WEIGHT and PLATE_<ROLE>_SHA256.
# Roles: PLATE, DIGIT, BRAND, COLOR, PLATE_COLOR.

# Line passages and PLATE events.
PLATE_EVENTS_ENABLED=true
PLATE_TRACK_TTL_SECONDS=2
PLATE_MAX_TRACKS=128
PLATE_CROSSING_DEADBAND=0.01
PLATE_EVENT_OCR_WAIT_SECONDS=2
PLATE_EVENT_PENDING_TTL_SECONDS=30
# Global pending-event limit across all cameras.
PLATE_EVENT_MAX_PENDING=128
PLATE_EVENT_RETRY_SECONDS=1
# Durable outbox; cooldown uses actual event time and separate recognition/violation keys.
# Docker defaults to /snapshots/event_delivery.sqlite3 (existing persistent bind).
PLATE_EVENT_COOLDOWN_SECONDS=10
# Hold ordinary recognition briefly so a nearby RED_LIGHT can carry both in one event.
PLATE_EVENT_RECOGNITION_HOLD_SECONDS=3
PLATE_EVENT_DELIVERY_TTL_SECONDS=120
PLATE_EVENT_RETENTION_SECONDS=86400
PLATE_EVENT_OUTBOX_MAX_PENDING=128
PLATE_EVENT_STATE_MAX_RECORDS=10000
PLATE_TRACK_HISTORY_SECONDS=4
PLATE_TRACK_HISTORY_FRAMES=64
# Keep counting associations, but reject violation/OCR evidence across uncertain identity links.
PLATE_IDENTITY_COST_MARGIN=0.1
PLATE_IDENTITY_MAX_GAP_SECONDS=0.5

# Realtime overlay.
PLATE_BBOX_ENABLED=true
PLATE_BBOX_MAX_FPS=10
# Token bucket: reserve one packet for fresh geometry ahead of OCR enrichment.
PLATE_BBOX_BURST_CAPACITY=2
PLATE_BBOX_MAX_FRAME_AGE_SECONDS=0.3
PLATE_BBOX_PLATE_MAX_AGE_SECONDS=1
# Supported alternative: smart_vms/bbox. Publish to one prefix per instance.
PLATE_BBOX_TOPIC_PREFIX=smart_vms/ai/bbox
# Red-light rule uses the existing vehicle/OCR/tracking workers (opt-in).
# All thresholds can be overridden in this JSON; Docker evidence must be writable.
RED_LIGHT_ENABLED=false
RED_LIGHT_SETTINGS='{"snapshot_dir":"/snapshots/red_light"}'
# With PLATE_SNAPSHOT_ENABLED=false, upload only verified RED_LIGHT evidence:
# RED_LIGHT_SETTINGS='{"snapshot_dir":"/snapshots/red_light","upload_snapshots":true}'

# Upload original crossing frames to https://MQTT_HOST/storage/upload/file.
PLATE_SNAPSHOT_ENABLED=true
PLATE_SNAPSHOT_TIMEOUT_SECONDS=4
PLATE_SNAPSHOT_ATTEMPTS=2
PLATE_SNAPSHOT_WAIT_SECONDS=10
PLATE_SNAPSHOT_WORKERS=2
PLATE_SNAPSHOT_MAX_PENDING=64
PLATE_SNAPSHOT_JPEG_QUALITY=90
